@page "/account/signin"
@using BlazorAccessControl.Interface
@inject IUserService<Guid> userService
@inject NavigationManager nav
<div style="margin: 0 auto; max-width: 800px;">

    <h3>Sign In</h3>
    <hr />
    <BlazorAccessControl.UI.SigninComponent.SignIn TKey="Guid" />
</div>
@code{
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            if (userService.CurrentUser is not null)
                nav.NavigateTo("/");
        }
        base.OnAfterRender(firstRender);
    }
}