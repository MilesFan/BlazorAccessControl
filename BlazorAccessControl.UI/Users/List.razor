@typeparam TKey where TKey : System.IEquatable<TKey>
@typeparam TUser where TUser : IUser<TKey>, new()
@inject IUserService<TKey> userService
@inject IJSRuntime js
<div style="display:flex; gap: 10px; margin-bottom: 1rem;">
    <button @onclick="Create">@Resource.Create</button>
</div>
<div style="display:flex; flex-direction:row; column-gap: 20px;align-items: start;">
    <table>
        <colgroup>
            <col style="min-width: 10rem;" />
            <col style="min-width: 10rem;" />
            <col style="min-width: 100px;" />
            <col style="min-width: 10rem;" />
        </colgroup>
        <thead>
            <tr>
                <th>@Resource.UserDisplayName</th>
                <th>@Resource.UserName</th>
                <th>@Resource.UserEmail</th>
                <th>@Resource.UserRoles</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in users)
            {
                <tr>
                    <td>@item.DisplayName</td>
                    <td>@item.UserName</td>
                    <td class="text-truncated">@item.Email</td>
                    <td>@string.Join(", ", item.GetRoles().Select(r=>r.Name))</td>
                    <td><button @onclick="() => Edit(item.Id)">@Resource.Edit</button></td>
                </tr>
            }
        </tbody>
    </table>
    @if (userIdInEdit?.Equals(default(TKey)) == false || CreateNew == true)
    {
        <Edit TKey="TKey" TUser="TUser" Id="@userIdInEdit" CreateNew="CreateNew" OnChange="OnEditComponentChanged" />
    }
</div>
@code {
    private ICollection<IUser<TKey>> users = Array.Empty<IUser<TKey>>();
    private TKey? userIdInEdit;
    private bool CreateNew;
    private void Create()
    {
        userIdInEdit = default;
        CreateNew = true;
    }
    public class UserWithRoles
    {
        public required IUser<TKey> User { get; set; }
        public IList<string> Roles { get; set; } = Array.Empty<string>();
    }
    private async Task Edit(TKey? id)
    {
        userIdInEdit = id;
    }
    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }
    private async Task OnEditComponentChanged(bool needReload)
    {
        userIdInEdit = default;
        CreateNew = false;
        if (needReload)
        {
            await ReloadAsync();
        }
    }
    private async Task ReloadAsync()
    {
        try
        {
            users = await userService.GetAllUsersAsync();
        }
        catch (Exception ex)
        {
            users = Array.Empty<IUser<TKey>>();
            Console.Error.WriteLine($"failed to load users: {ex}");
            //await js.InvokeVoidAsync("alert", $"º”‘ÿ”√ªß ß∞‹: {ex.Message}");
        }
    }

}
