@typeparam TKey where TKey : System.IEquatable<TKey>
@typeparam TUser where TUser : IUser<TKey>, new()
@inject IUserService<TKey> userService
@inject IJSRuntime js
<div style="display:flex; gap: 10px; margin-bottom: 1rem;">
    <button @onclick="Create">@Resource.Create</button>
</div>
<div style="display:flex; flex-direction:row; column-gap: 20px;align-items: start;">
    <table>
        <colgroup>
            <col style="min-width: 10rem;" />
            <col style="min-width: 10rem;" />
            <col style="min-width: 100px;" />
            <col style="min-width: 20rem;" />
            <col style="max-width: 5rem;" />
        </colgroup>
        <thead>
            <tr>
                <th>@Resource.UserDisplayName</th>
                <th>@Resource.UserName</th>
                <th>@Resource.UserEmail</th>
                <th>@Resource.UserRoles</th>
                <th></th>
            </tr>
            <tr class="filter-row">
                <th><input @bind="filterUserDisplayName" @bind:after="OnFilterChange" @bind:event="oninput" type="search" placeholder="" /></th>
                <th><input @bind="filterUserName" @bind:after="OnFilterChange" @bind:event="oninput" type="search" placeholder="" /></th>
                <th><input @bind="filterEmail" @bind:after="OnFilterChange" @bind:event="oninput" type="search" placeholder="" /></th>
                <th><input @bind="filterRole" @bind:after="OnFilterChange" @bind:event="oninput" type="search" placeholder="" /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @{
            var hasRoleFilter = !string.IsNullOrWhiteSpace(filterRole);
            foreach (var item in users)
            {
                <tr>
                    <td>@item.DisplayName</td>
                    <td>@item.UserName</td>
                    <td class="text-truncated">@item.Email</td>
                    <td>
                        <div class="roles">
                            @foreach (var role in item.GetRoles())
                            {
                                var highlighed = hasRoleFilter && role.Name?.Contains(filterRole, StringComparison.OrdinalIgnoreCase) == true;
                                <span class="role@(highlighed? " highlighted": "")">@role.Name</span>
                            }
                        </div>

                        @* @string.Join(", ", item.GetRoles().Select(r=>r.Name)) *@
                    </td>
                    <td><button @onclick="() => Edit(item.Id)">@Resource.Edit</button></td>
                </tr>
            }
        }
        </tbody>
    </table>
    @if (userIdInEdit?.Equals(default(TKey)) == false || CreateNew == true)
    {
        <Edit TKey="TKey" TUser="TUser" Id="@userIdInEdit" CreateNew="CreateNew" OnChange="OnEditComponentChanged" />
    }
</div>
@code {
    private ICollection<IUser<TKey>> usersAll = Array.Empty<IUser<TKey>>();
    private ICollection<IUser<TKey>> users = Array.Empty<IUser<TKey>>();
    private TKey? userIdInEdit;
    private bool CreateNew;
    private string? filterUserDisplayName;
    private string? filterUserName;
    private string? filterEmail;
    private string? filterRole;
    private void Create()
    {
        userIdInEdit = default;
        CreateNew = true;
    }
    public class UserWithRoles
    {
        public required IUser<TKey> User { get; set; }
        public IList<string> Roles { get; set; } = Array.Empty<string>();
    }
    private async Task Edit(TKey? id)
    {
        userIdInEdit = id;
    }
    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }
    private async Task OnEditComponentChanged(bool needReload)
    {
        userIdInEdit = default;
        CreateNew = false;
        if (needReload)
        {
            await ReloadAsync();
        }
    }
    private async Task ReloadAsync()
    {
        try
        {
            usersAll = await userService.GetAllUsersAsync();
            users = usersAll;
        }
        catch (Exception ex)
        {
            usersAll = Array.Empty<IUser<TKey>>();
            users = usersAll;
            Console.Error.WriteLine($"failed to load users: {ex}");
            //await js.InvokeVoidAsync("alert", $"º”‘ÿ”√ªß ß∞‹: {ex.Message}");
        }
    }
    private async Task OnFilterChange()
    {
        IEnumerable<IUser<TKey>> filterUsers = usersAll;
        if (!string.IsNullOrEmpty(filterUserDisplayName))
        {
            filterUsers = filterUsers.Where(i =>
                i.GetClaims()
                 .Any(c => c.ClaimType?.StartsWith("DisplayName-") == true &&
                           c.ClaimValue?.Contains(filterUserDisplayName, StringComparison.OrdinalIgnoreCase) == true));
        }
        if (!string.IsNullOrEmpty(filterUserName))
        {
            filterUsers = filterUsers.Where(i => i.UserName?.Contains(filterUserName, StringComparison.OrdinalIgnoreCase) == true);
        }
        if (!string.IsNullOrEmpty(filterEmail))
        {
            filterUsers = filterUsers.Where(i => i.Email?.Contains(filterEmail, StringComparison.OrdinalIgnoreCase) == true);
        }
        if (!string.IsNullOrEmpty(filterRole))
        {
            filterUsers = filterUsers.Where(i =>
                i.GetRoles()
                 .Any(r => r.Name?.Contains(filterRole, StringComparison.OrdinalIgnoreCase) == true));
        }
        users = filterUsers.ToArray();
    }
}

