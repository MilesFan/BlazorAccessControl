@typeparam TKey where TKey : System.IEquatable<TKey>
@inject IUserService<TKey> userService
@inject IJSRuntime js
@implements IAsyncDisposable
@inject NavigationManager nav
<button @onclick="Test">Test</button>
@code {
    private IJSObjectReference? guard;
    private async Task SetUp()
    {
        if (userService.CurrentUser != null)
        {
            var packagename = this.GetType().Namespace;
            var s = @"
(() => {
    let guard = { bc_loginguard: null, appid: null };
    guard.SetupLogoutListener = function (appid) {
        this.bc_loginguard = new BroadcastChannel(appid);
        this.appid = appid;
        this.bc_loginguard.onmessage = function (ev) {
            if (ev.data == 'UserLogout') window.location.href = 'about:blank';
        }
    }
    guard.NotifyLogout = function () {
        if (this.bc_loginguard) this.bc_loginguard.close(); // avoid loop
        let bc = new BroadcastChannel(this.appid);
        bc.postMessage('UserLogout');
        bc.close();
    }
    return guard;
})()";
            try
            {
                guard = await js.InvokeAsync<IJSObjectReference>("eval", s);
                if (guard == null)
                {
                    await js.InvokeVoidAsync("alert", "Code Editor Initialization Error.");
                    return;
                }
                await guard.InvokeVoidAsync("SetupLogoutListener", nav.BaseUri);
            }
            catch (Exception)
            {
                await js.InvokeVoidAsync("alert", "Code Editor Initialization Error.");
            }
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SetUp();
        }
    }
    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (guard is null) return;
        try
        {
            await guard.DisposeAsync();
        }
        catch(Exception) {}
    }

    public async Task Test()
    {
        try
        {
            if (guard is null) throw new Exception("Guard is null");
            await guard.InvokeVoidAsync("NotifyLogout");
        }
        catch(Exception ex)
        {
            await js.InvokeVoidAsync("alert", ex.Message);
        }
    }
}