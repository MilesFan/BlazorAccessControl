@typeparam TKey where TKey : System.IEquatable<TKey>
@typeparam TRole where TRole : IRole<TKey>, new()
@inject IUserService<TKey> userService
@inject IJSRuntime js
<div style="display:flex; gap: 10px; margin-bottom: 1rem;">
    <button @onclick="Create">@Resource.Create</button>
</div>
<div style="display:flex; flex-direction:row; column-gap: 20px;align-items: start;">
    <table>
        <colgroup>
            <col style="min-width: 10rem;" />
            <col style="min-width: 1rem;" />
        </colgroup>
        <thead>
            <tr>
                <th>@Resource.RoleName</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in roles)
            {
                <tr>
                    <td>@item.Name</td>
                    <td><button @onclick="() => Edit(item.Id)">@Resource.Edit</button></td>
                </tr>
            }
        </tbody>
    </table>
    @if (roleIdInEdit?.Equals(default) == false || CreateNew == true)
    {
        <Edit TKey="TKey" TRole="TRole" Id="@roleIdInEdit" CreateNew="CreateNew" OnChange="OnEditComponentChanged" />
    }
</div>

@code {
    private ICollection<IRole<TKey>> roles = Array.Empty<IRole<TKey>>();
    private TKey? roleIdInEdit;
    private bool CreateNew;
    private void Create()
    {
        roleIdInEdit = default;
        CreateNew = true;
    }
    private void Edit(TKey? id)
    {
        roleIdInEdit = id;
        CreateNew = false;
    }
    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }
    private async Task OnEditComponentChanged(bool needReload)
    {
        roleIdInEdit = default;
        CreateNew = false;
        if (needReload)
        {
            await ReloadAsync();
        }
    }
    private async Task ReloadAsync()
    {
        try
        {
            roles = await userService.GetAllRolesAsync();
        }
        catch (Exception ex)
        {
            roles = Array.Empty<IRole<TKey>>();
            Console.Error.WriteLine($"failed to load users: {ex}");
            //await js.InvokeVoidAsync("alert", $"º”‘ÿ”√ªß ß∞‹: {ex.Message}");
        }
    }

}
