@using System.Globalization
@using System.Threading.Tasks
@inject IJSRuntime js
@inject NavigationManager nav
@ChildContent
<dialog @ref="dialogRef"
        style="min-width: 300px; max-width: 600px; font-size: 14px; padding: 0px; max-height: calc(100vh - 20px); border: 1px solid gray; border-radius: 8px; box-shadow: 0px 0px 14px -5px rgba(66, 68, 90, 1); width: fit-content; top: 50vh; left: 50vw; margin: 0; transform: translate(-50%, -50%);"
        onmousewheel="return false;">
    @if (Show)
    {
    <div style="display:flex; flex-direction:column; max-width:90vw; max-height: calc(100vh - 20px);">
        <div ondragover="event.preventDefault();" style="flex: 0 1 auto; background-color:#00000010; border-bottom: 1px solid #00000040; display:flex; align-items:center; padding: 0px 10px 0px 10px; line-height:2rem; position:relative;">
            <div draggable="true" ondragstart="const rect = this.parentNode.parentNode.parentNode.getBoundingClientRect(); window.dialogPos = { posX: rect.left, posY: rect.top, mouseX: event.pageX, mouseY: event.pageY };" ondrag="if (event.screenX == 0) return; let d = this.parentNode.parentNode.parentNode; d.style.removeProperty('transform'); d.style.setProperty('left', (event.pageX - dialogPos.mouseX + dialogPos.posX) + 'px'); d.style.setProperty('top', (event.pageY - dialogPos.mouseY + dialogPos.posY) + 'px');" style="cursor: move; user-select: none; flex-grow: 1;">
                Language
            </div>
            <div style="display: flex; align-items:center; gap:10px;">
                <button type="button" @onclick="HideDialog" style="border:none; outline:none; background-color:transparent; padding:4px; font-size:16px; cursor: pointer;">✖</button>
            </div>
        </div>
        <div style="padding:10px;flex: 1 1 auto; overflow-y:auto;">
            <div style="display:flex; flex-direction:column; gap:10px;">
                @foreach (var cultureInfo in CultureInfos)
                {
                        <button @onclick="() => OnChange.InvokeAsync(cultureInfo.IetfLanguageTag)" style="border: 1px solid gray; padding: 0.2rem 0.4rem; border-radius: 6px;">
                        @cultureInfo.NativeName
                    </button>
                }
            </div>
        </div>
    </div>
    }
</dialog>
@code {
    private ElementReference dialogRef = default!;

    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter, EditorRequired]
    public CultureInfo[] CultureInfos { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<string> OnChange { get; set; }

    private bool Show;

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    public async Task ShowDialog()
    {
        Show = true;
        var dialogElement = await js.InvokeAsync<IJSObjectReference>("eval", dialogRef);
        await dialogElement.InvokeVoidAsync("showModal");
    }
    private async Task HideDialog()
    {
        Show = false;
        var dialogElement = await js.InvokeAsync<IJSObjectReference>("eval", dialogRef);
        await dialogElement.InvokeVoidAsync("close");
    }
}
