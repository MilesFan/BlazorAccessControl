@typeparam TKey where TKey : System.IEquatable<TKey>
@inject IUserService<TKey> userService
@inject IJSRuntime js
<div style="display:flex; flex-direction:column; flex-wrap:nowrap; --padding: 4px; ">
    <span style="display:flex; align-items:center;line-height: 1.2; white-space:nowrap; border: 1px solid gray; border-bottom: none; border-top-left-radius: 4px; border-top-right-radius: 4px; box-sizing:border-box; padding: var(--padding); width:fit-content; background-color: #f0f0f0;  ">
        @Resource.Tenant
    </span>
    <div style="border: 1px solid gray; outline:none; border-radius: 4px; border-top-left-radius: 0px; box-sizing:border-box; font-family:inherit; font-size:inherit; min-width:100%; overflow:hidden; padding: var(--padding);">
        <textarea @bind="Tenants" @bind:after="OnChanged" style="border: none; outline: none;width: 100%;height: 100%;background-color: transparent;color: inherit;" rows="4"></textarea>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public EventCallback<IUser<TKey>> UserChanged { get; set; }

    [Parameter, EditorRequired]
    public IUser<TKey> User { get; set; }

    private string Tenants = string.Empty;

    protected override void OnInitialized()
    {
        var tenants = User.GetClaims()
            .Where(i => (i.ClaimType == "MainTenant" || i.ClaimType == "Tenant") && !string.IsNullOrWhiteSpace(i.ClaimValue))
            .OrderBy(i => i.ClaimType != "MainTenant")
            .Select(i => i.ClaimValue!)
            .Distinct()
            .ToArray() ?? [];
        Tenants = string.Join('\n', tenants);
        base.OnInitialized();
    }
    private async Task OnChanged()
    {
        if (UserChanged.HasDelegate)
        {
            var tenants = Tenants.Split(['\n', '\r'], StringSplitOptions.RemoveEmptyEntries);
            User.SetClaimValues("Tenant", tenants);
            User.RemoveClaims("MainTenant");
            if (tenants.Length>0)
            {
                User.SetClaimValues("MainTenant", [tenants[0]]);
            }
            await UserChanged.InvokeAsync(User);
        }

    }
}
