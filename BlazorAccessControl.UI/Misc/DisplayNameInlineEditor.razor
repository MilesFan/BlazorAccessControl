@inject IJSRuntime js
<div style="display:flex; flex-direction:column; flex-wrap:nowrap; --padding: 4px; ">
    <span style="display:flex; align-items:center;line-height: 1.2; white-space:nowrap; border: 1px solid gray; border-bottom: none; border-top-left-radius: 4px; border-top-right-radius: 4px; box-sizing:border-box; padding: var(--padding); width:fit-content; background-color: #f0f0f0;  ">
        @Resource.UserDisplayName
    </span>
    <div style="border: 1px solid gray; outline:none; border-radius: 4px; border-top-left-radius: 0px; box-sizing:border-box; font-family:inherit; font-size:inherit; min-width:100%; overflow:hidden; padding: var(--padding);">
        <input @onclick="ShowDialog" readonly value="@User.DisplayName" style="border: none; outline: none;width: 100%;height: 100%;background-color: transparent;color: inherit;" />
    </div>
</div>
<dialog @ref="dialogRef"
        style="min-width: 300px; font-size: 14px; padding: 0px; max-height: calc(100vh - 20px); border: 1px solid gray; border-radius: 8px; box-shadow: 0px 0px 14px -5px rgba(66, 68, 90, 1); width: fit-content; top: 50vh; left: 50vw; margin: 0; transform: translate(-50%, -50%);"
        onmousewheel="return false;">
    <div style="display:flex; flex-direction:column; max-width:90vw; max-height: calc(100vh - 20px);">
        <div ondragover="event.preventDefault();" style="flex: 0 1 auto; background-color:#00000010; border-bottom: 1px solid #00000040; display:flex; align-items:center; padding: 0px 10px 0px 10px; line-height:2rem; position:relative;">
            <div draggable="true" ondragstart="const rect = this.parentNode.parentNode.parentNode.getBoundingClientRect(); window.dialogPos = { posX: rect.left, posY: rect.top, mouseX: event.pageX, mouseY: event.pageY };" ondrag="if (event.screenX == 0) return; let d = this.parentNode.parentNode.parentNode; d.style.removeProperty('transform'); d.style.setProperty('left', (event.pageX - dialogPos.mouseX + dialogPos.posX) + 'px'); d.style.setProperty('top', (event.pageY - dialogPos.mouseY + dialogPos.posY) + 'px');" style="cursor: move; user-select: none; flex-grow: 1;">
                @Resource.UserDisplayName
            </div>
            <div style="display: flex; align-items:center; gap:10px;">
                <button @onclick="HideDialog" type="button" style="border:none; outline:none; background-color:transparent; padding:4px; font-size:16px; cursor: pointer;">✖</button>
            </div>
        </div>
        <div style="padding:10px;flex: 1 1 auto; overflow-y:auto;">
        <div style="display: grid; grid-template-columns: 300px 300px 300px; gap: 10px; margin-bottom: 20px;">
            @foreach (var x in DisplayNames)
            {
                <div style="display:flex; flex-direction:column; flex-wrap:nowrap; --padding: 4px; ">
                    <span style="display:flex; align-items:center;line-height: 1.2; white-space:nowrap; border: 1px solid gray; border-bottom: none; border-top-left-radius: 4px; border-top-right-radius: 4px; box-sizing:border-box; padding: var(--padding); width:fit-content; background-color: #f0f0f0;  ">
                        @x.LanguageName
                    </span>
                    <div style="border: 1px solid gray; outline:none; border-radius: 4px; border-top-left-radius: 0px; box-sizing:border-box; font-family:inherit; font-size:inherit; min-width:100%; overflow:hidden; padding: var(--padding);">
                        <input @bind-value="@x.Value" style="border: none; outline: none;width: 100%;height: 100%;background-color: transparent;color: inherit;" />
                    </div>
                </div>
            }
        </div>
        </div>
        <div style="flex: 0 1; background-color:#00000010; padding:4px 10px 4px 10px; border-top:1px solid #00000040;">
            <div style="display:flex; gap:10px;">
                <button @onclick="Submit" style="border: 1px solid gray; padding: 0.2rem 0.4rem; border-radius: 6px;">
                    保存
                </button>
                <button @onclick="HideDialog" style="border: 1px solid gray; padding: 0.2rem 0.4rem; border-radius: 6px;">
                    取消
                </button>
            </div>
        </div>
    </div>
</dialog>

@code {

    private ElementReference dialogRef = default!;

    [Parameter, EditorRequired]
    public EventCallback<IUser> UserChanged { get; set; }

    [Parameter, EditorRequired]
    public IUser User { get; set; }

    private class Item
    {
        //public required string Key { get; set; }
        public required string LanguageCode { get; set; }
        public string? Value { get; set; }

        public string LanguageName => LanguageNativeNames.TryGetValue(LanguageCode, out var name) ? name : LanguageCode;
    }
    private Item[] DisplayNames = [];

    private void Load()
    {
        var existing = User.GetClaims()
            .Where(i => i.ClaimType?.StartsWith("DisplayName-") == true)
            .Select(i => new Item
                {
                 //Key = i.Id,
                LanguageCode = i.ClaimType!.Substring("DisplayName-".Length),
                Value =  i.ClaimValue
                })
            .ToArray();
        DisplayNames = LanguageNativeNames.Select(i =>
        {
            var a = existing.FirstOrDefault(e => e.LanguageCode == i.Key);
            if (a is not null)
            {
                return a;
            }
            else
            {
                return new Item { LanguageCode = i.Key, Value = null };
            }
        }).ToArray();
    }
    private async Task ShowDialog()
    {
        Load();
        var dialogElement = await js.InvokeAsync<IJSObjectReference>("eval", dialogRef);
        await dialogElement.InvokeVoidAsync("showModal");
    }
    private async Task HideDialog()
    {
        DisplayNames = [];
        var dialogElement = await js.InvokeAsync<IJSObjectReference>("eval", dialogRef);
        await dialogElement.InvokeVoidAsync("close");
    }
    private async Task Submit()
    {
        if (UserChanged.HasDelegate)
        {
            foreach(var item in DisplayNames)
            {
                User.UpsertClaim($"DisplayName-{item.LanguageCode}", item.Value);
            }
            await UserChanged.InvokeAsync(User);
        }
        await HideDialog();
    }

    private static readonly Dictionary<string, string> LanguageNativeNames = new Dictionary<string, string>
    {
        {"en", "English" },
        {"zh-Hans", "中文（简体）" },
        {"zh-Hant", "中文（繁體）" },
        {"de", "Deutsch" },
        {"es", "español" },
        {"fr", "français" },
        {"hi", "हिन्दी" },
        {"hu", "magyar" },
        {"ja", "日本語" },
        {"ko", "한국어" },
        {"nl", "Nederlands" },
        {"pt", "português" },
        {"ru", "русский" },
        {"sr", "српски" },
        {"tr", "Türkçe" }
    };
}
